rules_version = '2';

// Paste into Firebase console → Firestore Database → Rules, then Publish.
//
// Enforced on the server, so a modified browser can't break the game:
//   - every phone signs in anonymously and gets its own uid
//   - an order can be taken once (create only — never overwritten)
//   - each phone can take one order per round
//   - only the player who took an order can mark it delivered
//   - nothing can be deleted from the app (reset a round in the console)

service cloud.firestore {
  match /databases/{database}/documents {

    match /rounds/{round}/orders/{orderId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['status', 'shipper', 'uid', 'claimedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'delivering'
        && request.resource.data.shipper is string
        && request.resource.data.shipper.size() > 0
        && request.resource.data.shipper.size() <= 24
        && !exists(/databases/$(database)/documents/rounds/$(round)/players/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/rounds/$(round)/players/$(request.auth.uid)).data.orderId == orderId;

      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && resource.data.status == 'delivering'
        && request.resource.data.status == 'delivered'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'deliveredAt']);

      allow delete: if false;
    }

    // One document per phone: which order it took. Written in the same
    // transaction as the order, which is what limits players to one order.
    match /rounds/{round}/players/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'orderId', 'claimedAt'])
        && existsAfter(/databases/$(database)/documents/rounds/$(round)/orders/$(request.resource.data.orderId));
      allow update, delete: if false;
    }
  }
}
